<Window x:Class="EdicaoFotos.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor" Height="650" Width="1000" Background="#111">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>    <!-- barrinha do topo -->
            <RowDefinition Height="3*"/>    <!-- laterais + imagem -->
            <RowDefinition Height="*"/>     <!-- barra de baixo (~1/4 da altura) -->
            <RowDefinition Height="12"/>    <!-- espaço no final -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/> <!-- barra esquerda -->
            <ColumnDefinition Width="*"/>   <!-- área da imagem -->
            <ColumnDefinition Width="140"/> <!-- barra direita -->
        </Grid.ColumnDefinitions>

        <!-- BARRINHA DO TOPO (vazia, para Arquivo, Pasta etc.) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#222" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel x:Name="TopBar" Orientation="Horizontal" Margin="8,0"
                        VerticalAlignment="Center">
            </StackPanel>
        </Border>

        <!-- BARRA ESQUERDA -->
        <Border Grid.Row="1" Grid.Column="0" Background="#222" CornerRadius="8" Margin="0,0,8,8">
            <StackPanel x:Name="LeftPanel" Margin="8">
                <Button x:Name="SelectImageButton" Content="Select Image" Height="36" Margin="0,0,0,6"/>
                <Button x:Name="SaveButton" Content="Salvar" Height="36"/>
            </StackPanel>
        </Border>

        <!-- ÁREA DA IMAGEM (centro) -->
        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A1A" CornerRadius="8" Margin="0,0,0,8">
            <Image x:Name="ImageControl" Stretch="Uniform" Margin="8"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- BARRA DIREITA -->
        <Border Grid.Row="1" Grid.Column="2" Background="#222" CornerRadius="8" Margin="8,0,0,8">
            <StackPanel x:Name="RightPanel" Margin="8">
                <TextBlock Text="Propriedades" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock x:Name="ImageSizeText" Foreground="White" Text="Sem imagem"
           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- BARRA DE BAIXO (largura toda) -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#222" CornerRadius="8">
            <Grid>
                <!-- ferramentas principais -->
                <StackPanel x:Name="MainToolsPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- contraste -->
                    <Button x:Name="ContrastButton" Content="Contraste" Click="ContrastButton_Click" Width="100" Height="64" Margin="6"/>

                    <!-- brilho -->
                    <Button x:Name="BrightnessButton" Content="Brilho" Click="BrightnessButton_Click" Width="100" Height="64" Margin="6"/>
                    
                    <!-- gama -->
                    <Button x:Name="GammaButton" Content="Gama" Click="GammaButton_Click" Width="100" Height="64" Margin="6"/>

                    <!-- Chroma Key -->
                    <Button x:Name="ChromaKeyButton" Content="ChromaKey" Width="100" Height="64" Margin="6"/>
                </StackPanel>

                <!-- contraste -->
                <StackPanel x:Name="ContrastPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button x:Name="ContrastBackButton" Content="← Voltar" Width="100" Height="64" Margin="6"
                    Click="ContrastBackButton_Click"/>

                    <TextBlock Text="Contraste" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0"/>

                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"
                    Width="300" VerticalAlignment="Center"
                    ValueChanged="ContrastSlider_ValueChanged"/>

                    <TextBox x:Name="ContrastTextBox" Text="0" Width="55" Height="28" Margin="12,0,0,0"
                    VerticalAlignment="Center" VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    KeyDown="ContrastTextBox_KeyDown"/>
                </StackPanel>

                <!-- brilho -->
                <StackPanel x:Name="BrightnessPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button x:Name="BrightnessBackButton" Content="← Voltar" Width="100" Height="64" Margin="6"
                    Click="BrightnessBackButton_Click"/>

                    <TextBlock Text="Brilho" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0"/>

                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0"
                    Width="300" VerticalAlignment="Center"
                    ValueChanged="BrightnessSlider_ValueChanged"/>

                    <TextBox x:Name="BrightnessTextBox" Text="0" Width="55" Height="28" Margin="12,0,0,0"
                    VerticalAlignment="Center" VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    KeyDown="BrightnessTextBox_KeyDown"/>
                </StackPanel>

                <!-- GAMA -->
                <StackPanel x:Name="GammaPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">

                    <Button x:Name="GammaBackButton" Content="← Voltar" Click="GammaBackButton_Click" Width="100" Height="64" Margin="6"/>

                    <!-- Gráfico da curva -->
                    <Border Margin="16,0,16,0" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                        Width="112" Height="112" VerticalAlignment="Center">
                        <Canvas x:Name="GammaCanvas" Width="110" Height="110"
                            Background="#1A1A1A" ClipToBounds="True" 
                            MouseMove="GammaCanvas_MouseMove" MouseUp="GammaCanvas_MouseUp">

                            <!-- Grade -->
                            <Line X1="27.5" Y1="0" X2="27.5" Y2="110" Stroke="#333" StrokeThickness="1"/>
                            <Line X1="55"   Y1="0" X2="55"   Y2="110" Stroke="#333" StrokeThickness="1"/>
                            <Line X1="82.5" Y1="0" X2="82.5" Y2="110" Stroke="#333" StrokeThickness="1"/>
                            <Line X1="0" Y1="27.5" X2="110" Y2="27.5" Stroke="#333" StrokeThickness="1"/>
                            <Line X1="0" Y1="55"   X2="110" Y2="55"   Stroke="#333" StrokeThickness="1"/>
                            <Line X1="0" Y1="82.5" X2="110" Y2="82.5" Stroke="#333" StrokeThickness="1"/>

                            <!-- Diagonal de referência (sem mudança) -->
                            <Line X1="0" Y1="110" X2="110" Y2="0"
                                Stroke="#777" StrokeThickness="1" StrokeDashArray="3 3"/>

                            <!-- Curva (começa igual à diagonal; o código vai trocar os pontos) -->
                            <Polyline x:Name="GammaCurve" Points="0,110 110,0"
                                Stroke="#4DA3FF" StrokeThickness="2"/>

                            <!-- Ponto arrastável (centro em 55,55) -->
                            <Ellipse x:Name="GammaPoint" Width="12" Height="12"
                                Fill="#4DA3FF" Stroke="White" StrokeThickness="2"
                                Canvas.Left="49" Canvas.Top="49" Cursor="Hand"
                                MouseDown="GammaPoint_MouseDown"/>
                        </Canvas>
                    </Border>

                    <TextBlock Text="Gama" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Slider x:Name="GammaSlider" Minimum="0.2" Maximum="3" Value="1"
                        Width="260" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="0.05"
                        ValueChanged="GammaSlider_ValueChanged"/>
                        
                    <TextBox x:Name="GammaTextBox" Text="1" Width="55" Height="28" Margin="12,0,0,0"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        TextAlignment="Center" KeyDown="GammaTextBox_KeyDown"/>
                </StackPanel>

                <!-- Chroma Key -->
                <StackPanel x:Name="ChromaKeyPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>